#!/usr/bin/env bash
#
# hal-voice — a HAL-9000 voice for Claude Code: speak to it, it answers aloud.
#
#   hal-voice              start the voice loop (wake word + push-to-talk → the brain → spoken reply)
#   hal-voice repl         alias for the default voice loop
#   hal-voice mcp          run ONLY the MCP speak/listen server (for use inside a normal `hal` TUI)
#   hal-voice tts "text"   one-shot: synthesize + speak a line in HAL's voice (no Claude, no mic)
#   hal-voice listen       one-shot: capture one utterance and print the transcript
#   hal-voice devices      list audio input/output devices
#   hal-voice eye          run the red-eye UI on its own (demo the animation states)
#   hal-voice doctor       check that every dependency + the GPT-SoVITS server are reachable
#   hal-voice voicetest    replay a recording of voicetest/script.txt through hands-free listening
#   hal-voice connection   show which Claude Code setup it will drive, and why
#   hal-voice help         show this help
#
# Global option:  --project DIR   run Claude Code in DIR (claude mode; default: [hal].vault)
#
# hal-voice runs no language model of its own: it records you, hands the words to a brain,
# and speaks the reply in HAL's voice. In direct mode (the default) that brain is core Hal's
# (halcore, found through HAL_CORE or the ecosystem layout) with the hal-hub tools; in claude
# mode it is Claude Code, run headless. See README.md and halvoice/connect.py.
#
set -uo pipefail

VOICE_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
VENV="$VOICE_ROOT/.venv"
PY="$VENV/bin/python"
CONFIG="${HALVOICE_CONFIG:-$VOICE_ROOT/config.yaml}"

usage() { sed -n '3,17p' "$0" | sed 's/^# \{0,1\}//'; }

# --- Global options, accepted before or after the subcommand -----------------
ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --project) export HALVOICE_CLAUDE_PROJECT_DIR="${2:-}"; shift 2 || true ;;
    --project=*) export HALVOICE_CLAUDE_PROJECT_DIR="${1#*=}"; shift ;;
    *) ARGS+=("$1"); shift ;;
  esac
done
set -- "${ARGS[@]+"${ARGS[@]}"}"

# Fall back to system python if the venv isn't built yet (so `doctor` can still run).
if [ ! -x "$PY" ]; then PY="$(command -v python3 || true)"; fi
if [ -z "${PY:-}" ]; then echo "No Python found. Run ./setup-voice.sh first."; exit 1; fi

# Voice profile from setup-voice.sh: decides whether speech recognition runs on the GPU
# or the CPU. Exported as HALVOICE_STT_* so config.py's env-override mechanism applies it
# over config.yaml. Anything already in your shell still wins.
VOICE_CONF="${HALVOICE_CONF:-$VOICE_ROOT/voice.conf}"
if [ -f "$VOICE_CONF" ]; then
  # shellcheck disable=SC1090
  . "$VOICE_CONF"
  export HALVOICE_PROFILE HALVOICE_STT_DEVICE HALVOICE_STT_COMPUTE_TYPE \
         HALVOICE_TTS_DEVICE HALVOICE_TTS_HALF
fi

export HALVOICE_ROOT="$VOICE_ROOT"
export HALVOICE_CONFIG="$CONFIG"
# Make the package importable whether or not it was pip-installed.
export PYTHONPATH="$VOICE_ROOT:${PYTHONPATH:-}"

cmd="${1:-repl}"; shift || true
case "$cmd" in
  help|-h|--help) usage; exit 0 ;;
  repl|"")        exec "$PY" -m halvoice.loop "$@" ;;
  mcp)            exec "$PY" -m halvoice.mcp_server "$@" ;;
  tts)            exec "$PY" -m halvoice.tts --say "$*" ;;
  listen)         exec "$PY" -m halvoice.stt --once ;;
  devices)        exec "$PY" -m halvoice.devices ;;
  eye)            exec "$PY" -m halvoice.ui_eye --demo ;;
  doctor)         exec "$PY" -m halvoice.doctor ;;
  connection)     exec "$PY" -m halvoice.connect ;;
  voicetest)      exec "$PY" -m voicetest "$@" ;;
  *)              echo "Unknown command: $cmd"; echo; usage; exit 1 ;;
esac
