# hal-voice — keep heavy/sensitive artifacts out of git
.venv/
__pycache__/
*.pyc

# Resolved voice profile for THIS machine (written by setup-voice.sh)
voice.conf

# GPT-SoVITS clone + its big pretrained models
gptsovits/GPT-SoVITS

# Trained HAL voice (sensitive — do NOT distribute; see voice-data/README.md)
gptsovits/weights

# ---------------------------------------------------------------------------
# HAL voice audio — NEVER commit. This is Douglas Rain's performance from the
# film (copyright Warner Bros. / the Kubrick & Clarke estates). It is restored
# locally by `voice-data/fetch-voice-lines.py` from a source YOU supply.
# ---------------------------------------------------------------------------
voice-data/raw/
voice-data/separated/
voice-data/denoised/
voice-data/clean/
voice-data/reference/
voice-data/hal-voice/          # your clips + transcripts.csv, read by prepare_dataset.py
voice-data/reference.txt
voice-data/slices/
voice-source.local             # your private source path/URL (see .example)

# Belt-and-braces: no audio and no transcripts of any kind get committed.
transcripts.csv
*.mp3
*.wav
*.flac
*.m4a
*.ogg

# Models cache (faster-whisper, openwakeword)
models/
*.onnx
*.ckpt
*.pth

# Local editor + tooling config
CC-Session-Logs/
.claude/

# Logs / scratch
*.log

# Tuning runs: synthesised samples, scores and cached film measurements
gptsovits/tuning/
voice-data/reference.october-backup/
